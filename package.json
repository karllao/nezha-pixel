{
  "name": "nezha-pocket-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "package:dist": "node scripts/package-dist.mjs",
    "build:release": "npm run build && npm run package:dist",
    "build:user-dist": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build --outDir ../nezha/dashboard/user-dist",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^7.1.3",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.2",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "world-countries": "^5.1.0"
  }
}
