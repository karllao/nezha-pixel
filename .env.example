# Nezha Pixel — 本地调试环境变量示例
# 复制为 .env.local 并填写你的线上地址

# REST API 地址（不含 /api/v1）
VITE_API_TARGET=https://your-nezha.example.com

# WebSocket 地址（可选，默认从 VITE_API_TARGET 自动推导）
# 如线上是 https，会自动用 wss；http 则用 ws
# VITE_WS_TARGET=wss://your-nezha.example.com

# 如目标用的是自签名证书或本地证书不可信，可设为 1 跳过 TLS 校验
# VITE_API_INSECURE=0
